# ── Orimise AI API (Claude-compatible proxy) ──────────────────────
# Lấy từ nhà cung cấp Orimise của bạn
ORIMISE_API_KEY=your_orimise_api_key_here
ORIMISE_BASE_URL=https://your-orimise-endpoint.com

# Tên model (để trống = claude-sonnet-4-6)
AI_MODEL=claude-sonnet-4-6

# ── JWT ───────────────────────────────────────────────────────────
# Thay bằng chuỗi ngẫu nhiên dài khi deploy production
JWT_SECRET=huevivu_change_this_in_production_32chars

# ── Server (chỉ dùng khi chạy local) ─────────────────────────────
PORT=3000
